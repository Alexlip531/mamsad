<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mamsad_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Search by name -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/filters_search_hint"
                app:boxStrokeColor="@color/mamsad_coral"
                app:boxBackgroundColor="@color/mamsad_white"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/mamsad_ink_mute">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/mamsad_ink"
                    android:textSize="14sp"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- City section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filters_section_city"
                android:textColor="@color/mamsad_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true" />

            <!-- Type section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filters_section_type"
                android:textColor="@color/mamsad_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true" />

            <!-- Category section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filters_section_category"
                android:textColor="@color/mamsad_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Sort section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/filters_section_sort"
                android:textColor="@color/mamsad_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rb_sort_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filters_sort_new"
                    android:textColor="@color/mamsad_ink"
                    android:paddingVertical="6dp"
                    android:buttonTint="@color/mamsad_coral" />

                <RadioButton
                    android:id="@+id/rb_sort_alpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filters_sort_alpha"
                    android:textColor="@color/mamsad_ink"
                    android:paddingVertical="6dp"
                    android:buttonTint="@color/mamsad_coral" />

                <RadioButton
                    android:id="@+id/rb_sort_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filters_sort_city"
                    android:textColor="@color/mamsad_ink"
                    android:paddingVertical="6dp"
                    android:buttonTint="@color/mamsad_coral" />

                <RadioButton
                    android:id="@+id/rb_sort_rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filters_sort_rating"
                    android:textColor="@color/mamsad_ink"
                    android:paddingVertical="6dp"
                    android:buttonTint="@color/mamsad_coral" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/mamsad_white"
        android:elevation="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Mamsad.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filters_btn_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            style="@style/Widget.Mamsad.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_marginStart="8dp"
            android:text="@string/filters_btn_apply" />
    </LinearLayout>
</LinearLayout>
