<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme -->
    <style name="Theme.Mamsad" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mamsad_coral</item>
        <item name="colorOnPrimary">@color/mamsad_white</item>
        <item name="colorPrimaryContainer">@color/mamsad_coral_light</item>
        <item name="colorOnPrimaryContainer">@color/mamsad_coral_dark</item>
        <item name="colorSecondary">@color/mamsad_sage</item>
        <item name="colorOnSecondary">@color/mamsad_white</item>
        <item name="colorSecondaryContainer">@color/mamsad_sage_light</item>
        <item name="colorOnSecondaryContainer">@color/mamsad_sage_dark</item>
        <item name="colorTertiary">@color/mamsad_sun</item>
        <item name="colorOnTertiary">@color/mamsad_ink</item>
        <item name="android:colorBackground">@color/mamsad_cream</item>
        <item name="colorOnBackground">@color/mamsad_ink</item>
        <item name="colorSurface">@color/mamsad_white</item>
        <item name="colorOnSurface">@color/mamsad_ink</item>
        <item name="colorSurfaceVariant">@color/mamsad_cream_dark</item>
        <item name="colorOnSurfaceVariant">@color/mamsad_ink_soft</item>
        <item name="colorOutline">@color/mamsad_divider</item>
        <item name="colorError">@color/mamsad_coral_dark</item>
        <item name="android:statusBarColor">@color/mamsad_coral</item>
        <item name="android:navigationBarColor">@color/mamsad_cream</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash theme (matches first frame, avoids jump) -->
    <style name="Theme.Mamsad.Splash" parent="Theme.Mamsad">
        <item name="android:statusBarColor">@color/mamsad_coral</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Mamsad.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/mamsad_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Mamsad.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/mamsad_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Mamsad.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/mamsad_ink_soft</item>
    </style>

    <style name="TextAppearance.Mamsad.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/mamsad_ink_mute</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Mamsad.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="backgroundTint">@color/mamsad_coral</item>
    </style>

    <style name="Widget.Mamsad.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/mamsad_coral</item>
        <item name="android:textColor">@color/mamsad_coral</item>
    </style>

    <style name="Widget.Mamsad.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/mamsad_white</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.Mamsad.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
</resources>
